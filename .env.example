# ==============================================================================
# Environment Variables Configuration
# Copy this file to .env and replace placeholder values with your real keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI Assistant
# Get your free API key at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. Admin Security & Authentication
# Used for /admin access gate and HMAC-SHA256 session token generation.
# ------------------------------------------------------------------------------
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_SESSION_SECRET=your_random_hmac_secret_string_min_32_characters

# ------------------------------------------------------------------------------
# 3. Upstash Redis (For Vercel Serverless Persistent Visitor Counting)
# Option A (Recommended): Connect directly in Vercel Dashboard -> Storage -> Upstash Redis
# Option B: Create a free database at: https://console.upstash.com/
# Note: If omitted, system automatically falls back to local file storage (src/core/data/analytics.json)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# Also compatible with Vercel KV Marketplace keys:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
